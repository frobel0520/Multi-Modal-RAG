# Cloudflare Worker local dev (.dev.vars) — never commit real secrets
APP_URL=http://127.0.0.1:8787

# Google OAuth (Owner allowlist login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
OWNER_EMAIL_ALLOWLIST=owner@example.com
SESSION_SECRET=replace-with-32-byte-random-hex

# Supabase (pgvector + Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini API (Free Tier, no billing enabled)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Rate limits (KV enforced)
DAILY_GLOBAL_QUERY_LIMIT=250
DAILY_PER_USER_QUERY_LIMIT=100
